# Per-session goal files written by .claude/hooks/goal-refresh.sh, and the local
# switch that turns the dev hooks off. See docs/development/hooks.md.
.claude/active-goal
.claude/active-goal.*
.claude/hooks-off
.claude/settings.local.json

__pycache__/

# Generated code from `buf generate` (buf.gen.yaml); never committed.
gen/

# Release archives from `make dist` (scripts/release-build.sh); published to
# GitHub Releases, never committed.
dist/

# review marker read by the global agent-config push hook (never committed)
.claude-review-ok

# Tools that `make tools` builds with the local Go (pinned in tool-versions.env).
.bin/
tools/tscheck/node_modules/

# web/dist is build output served by fleetd (see web/.gitignore); only the
# placeholder web/dist/index.html is committed. The Playwright smoke builds
# the real page and restores the placeholder afterwards.
# Playwright smoke: phone-width screenshots (described in the PR, never
# committed) and the run's URL/state files.
web/e2e/screenshots/
web/e2e/.e2e-url
web/e2e/.e2e-state.json
