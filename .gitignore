# Per-session goal files written by .claude/hooks/goal-refresh.sh, and the local
# switch that turns the dev hooks off. See docs/development/hooks.md.
.claude/active-goal
.claude/active-goal.*
.claude/hooks-off
.claude/settings.local.json

__pycache__/

# Generated code from `buf generate` (buf.gen.yaml); never committed.
gen/

# review marker read by the global agent-config push hook (never committed)
.claude-review-ok

# Tools that `make tools` builds with the local Go (pinned in tool-versions.env).
.bin/
