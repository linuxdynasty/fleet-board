# Every pinned tool version lives here and nowhere else (ADR 0020, plan row 0.10).
#
# Plain KEY=value lines, so the Makefile can `include` this file and a shell
# (CI) can `.` it. Keep comments on their own lines, no spaces around `=`.
# scripts/check-versions.sh keeps the copies that other tools force on us
# (.node-version, the go line of go.mod, buf.gen.yaml, tools/tscheck) equal to
# this file, and fails if the Makefile or a workflow spells out a pin.
#
# The protoc plugin versions (protoc-gen-go, protoc-gen-connect-go) stay in
# buf.gen.yaml next to the plugins they pin; protoc-gen-es is repeated here
# because @bufbuild/protobuf must use the same version (ADR 0020).

# Go toolchain: must equal the `go` line of go.mod. Never go.mod's `toolchain`.
GO_VERSION=1.27
# Node major for the UI and the TypeScript check: must equal .node-version.
NODE_MAJOR=24

# golangci-lint v2 built with the Go 1.27 toolchain (installed by `make tools`
# with the local Go into .bin/; the copy on PATH is built with an older Go and
# refuses a go 1.27 module).
GOLANGCI_LINT_VERSION=v2.14.0
# buf runs through `go run`, so a clean checkout needs only Go.
BUF_VERSION=v1.73.0
GOFUMPT_VERSION=v0.12.0
# govulncheck (golang.org/x/vuln), built into .bin/ by `make tools`; `make vuln`
# fails on a known vulnerability that the code can reach.
GOVULNCHECK_VERSION=v1.8.0
# benchstat (golang.org/x/perf, which has no release tags, so a pseudo-version)
# compares base and head benchmarks for make bench-report; runs through go run.
BENCHSTAT_VERSION=v0.0.0-20260929162123-406019bb8b68
# Lints .github/workflows (make actionlint, also a CI step); runs through go run.
ACTIONLINT_VERSION=v1.7.12

# tools/tscheck compiles the generated TypeScript (ADR 0020: typescript 7).
TYPESCRIPT_VERSION=7.0.2
PROTOC_GEN_ES_VERSION=2.16.0
