# The hub as a Linux user service (02j). Install beside
# packaging/systemd/fleet-agent.service on a Linux hub host.
#
# Start it only after `fleetd init` created the store (`fleetd run` refuses
# to start with none). To also hold off sleep while the hub runs, add a
# drop-in that wraps the start in systemd-inhibit (see docs/runbooks/install.md);
# the unit itself stays plain so it starts on hosts without inhibit.
[Unit]
Description=Fleet hub
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
ExecStart="%h/.local/bin/fleetd" run
WorkingDirectory=%h
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=2
KillSignal=SIGTERM
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
